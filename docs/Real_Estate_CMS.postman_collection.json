
{
  "info": {
    "name": "Real Estate CMS API",
    "description": "API collection for the Real Estate CMS company assignment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://real-estate-cms-qtgi.onrender.com/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "projectId",
      "value": "1"
    },
    {
      "key": "recordId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"REPLACE_WITH_PASSWORD\"\n}"
            }
          }
        },
        {
          "name": "Get Current Admin",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "List Projects",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/cms/projects"
          }
        },
        {
          "name": "Get Project",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/cms/projects/{{projectId}}"
          }
        },
        {
          "name": "Create Project",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/cms/projects",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo Property\",\n  \"slug\": \"demo-property\",\n  \"location\": \"Mumbai\",\n  \"description\": \"Demonstration property\",\n  \"status\": \"draft\"\n}"
            }
          }
        },
        {
          "name": "Update Project",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/cms/projects/{{projectId}}",
            "body": {
              "mode": "raw",
              "raw": "{\"status\":\"published\"}"
            }
          }
        },
        {
          "name": "Delete Record",
          "request": {
            "method": "DELETE",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/cms/projects/{{recordId}}"
          }
        }
      ]
    },
    {
      "name": "Content Collections",
      "item": [
        {
          "name": "List Sections",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/cms/sections?projectId={{projectId}}"
          }
        },
        {
          "name": "List Amenities",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/cms/amenities?projectId={{projectId}}"
          }
        },
        {
          "name": "List Gallery",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/cms/gallery?projectId={{projectId}}"
          }
        },
        {
          "name": "List Floor Plans",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/cms/floorPlans?projectId={{projectId}}"
          }
        }
      ]
    },
    {
      "name": "Inquiries",
      "item": [
        {
          "name": "Submit Inquiry",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/inquiries",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectId\": 1,\n  \"name\": \"Test Customer\",\n  \"email\": \"customer@example.com\",\n  \"phone\": \"9876543210\",\n  \"message\": \"Please share more information.\"\n}"
            }
          }
        },
        {
          "name": "List Inquiries",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/inquiries"
          }
        },
        {
          "name": "Update Inquiry",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/inquiries/{{recordId}}",
            "body": {
              "mode": "raw",
              "raw": "{\"status\":\"contacted\"}"
            }
          }
        }
      ]
    },
    {
      "name": "Audit Logs",
      "item": [
        {
          "name": "Get Activity Logs",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/cms/activity-logs"
          }
        }
      ]
    }
  ]
}
