
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  location    String?
  description String?
  heroImage   String?
  status      String   @default("draft")
  seoTitle    String?
  seoDesc     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sections    Section[]
  amenities   Amenity[]
  gallery     Gallery[]
  floorPlans  FloorPlan[]
  inquiries   Inquiry[]
}

model Section {
  id        Int      @id @default(autoincrement())
  projectId Int
  title     String
  content   String   @db.Text
  type      String
  imageUrl  String?
  status    String   @default("draft")
  order     Int      @default(0)

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Amenity {
  id        Int     @id @default(autoincrement())
  projectId Int
  name      String
  icon      String?
  imageUrl  String?
  status    String  @default("draft")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Gallery {
  id        Int     @id @default(autoincrement())
  projectId Int
  title     String?
  imageUrl  String
  category  String?
  status    String  @default("draft")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model FloorPlan {
  id        Int     @id @default(autoincrement())
  projectId Int
  name      String
  carpetArea Float?
  totalArea  Float?
  imageUrl  String?
  pdfUrl    String?
  status    String  @default("draft")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Inquiry {
  id        Int      @id @default(autoincrement())
  projectId Int
  name      String
  email     String
  phone     String?
  message   String   @db.Text
  status    String   @default("new")
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id         Int      @id @default(autoincrement())
  adminId    Int?
  action     String
  entity     String
  entityId   Int?
  details    String?
  createdAt  DateTime @default(now())
}
